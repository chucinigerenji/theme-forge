<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingTop="10dp"
        android:paddingRight="20dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/tvSlot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_dim"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etW"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/field"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="5"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_marginRight="8dp"
                android:text="×"
                android:textColor="@color/text"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/etH"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/field"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="5"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:text="px"
                android:textColor="@color/text_dim"
                android:textSize="13sp" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/cbRatio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="锁定宽高比（改一边自动算另一边）"
            android:textColor="@color/text"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipDef"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/chip"
                android:gravity="center"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chipScreen"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginLeft="8dp"
                android:background="@drawable/chip"
                android:gravity="center"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chipSwap"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginLeft="8dp"
                android:background="@drawable/chip"
                android:gravity="center"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chipOrig"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginLeft="8dp"
                android:background="@drawable/chip"
                android:gravity="center"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="缩放方式"
            android:textColor="@color/text"
            android:textSize="13sp" />

        <RadioGroup
            android:id="@+id/rgMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rb0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="拉伸铺满（可能变形）"
                android:textColor="@color/text"
                android:textSize="13sp" />

            <RadioButton
                android:id="@+id/rb1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="等比裁切铺满（推荐）"
                android:textColor="@color/text"
                android:textSize="13sp" />

            <RadioButton
                android:id="@+id/rb2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="完整放入（留透明边）"
                android:textColor="@color/text"
                android:textSize="13sp" />
        </RadioGroup>

        <TextView
            android:id="@+id/tvHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/text_dim"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
