<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/card_bg"
    android:orientation="vertical"
    android:paddingLeft="16dp"
    android:paddingRight="16dp">

    <LinearLayout
        android:id="@+id/headerRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="15dp"
        android:paddingBottom="15dp">

        <TextView
            android:id="@+id/tvName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="8dp"
            android:textColor="@color/text_dim"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvArrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="▾"
            android:textColor="@color/text_dim"
            android:textSize="16sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="14dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_dim"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/groupRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="范围"
                android:textColor="@color/text_dim"
                android:textSize="12sp" />

            <Spinner
                android:id="@+id/spGroup"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginLeft="6dp"
                android:layout_weight="1" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvScopeHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/text_dim"
            android:textSize="10sp"
            android:visibility="gone" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

            <Button
                android:id="@+id/btnFillAll"
                style="@style/Btn"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:text="整组套用一张图" />

            <Button
                android:id="@+id/btnGroupSize"
                style="@style/Btn"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginLeft="8dp"
                android:text="本组尺寸" />

            <Button
                android:id="@+id/btnClearAll"
                style="@style/Btn"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginLeft="8dp"
                android:text="清空本项" />

            <Button
                android:id="@+id/btnZip"
                style="@style/Btn"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginLeft="8dp"
                android:text="导入图标包 .zip"
                android:visibility="gone" />
            </LinearLayout>
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/slotBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/btnMore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/btn_gray"
            android:gravity="center"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:textColor="@color/primary"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
